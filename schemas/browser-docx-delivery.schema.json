{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juriscribe.local/schemas/browser-docx-delivery.schema.json",
  "title": "Juriscribe browser DOCX delivery receipt",
  "type": "object",
  "required": ["schema", "profile", "status", "required_docx_roles", "records", "errors", "downloadable_artifacts_only_docx", "dashboard_is_browser_surface_not_attachment", "assistant_agnostic", "user_agent_agnostic_runtime_contract", "browser_native_download_links", "global_browser_behavior_claim"],
  "properties": {
    "schema": {"const": "juriscribe-browser-docx-delivery/v1"},
    "profile": {"const": "JURISCRIBE_BROWSER_DOCX_DELIVERY_V1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "required_docx_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "href", "download_filename", "media_type", "content_disposition", "same_session_relative", "browser_native_anchor", "javascript_required", "status"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "href": {"type": ["string", "null"]},
          "download_filename": {"type": "string", "pattern": "(?i)\\.docx$"},
          "media_type": {"const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"},
          "content_disposition": {"type": "string", "pattern": "^attachment;"},
          "same_session_relative": {"type": "boolean"},
          "browser_native_anchor": {"const": true},
          "javascript_required": {"const": false},
          "status": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "downloadable_artifacts_only_docx": {"type": "boolean"},
    "dashboard_is_browser_surface_not_attachment": {"type": "boolean"},
    "assistant_agnostic": {"const": true},
    "user_agent_agnostic_runtime_contract": {"const": true},
    "browser_native_download_links": {"const": true},
    "global_browser_behavior_claim": {"const": false}
  },
  "additionalProperties": true
}
