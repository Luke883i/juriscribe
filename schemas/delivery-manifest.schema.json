{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Juriscribe final delivery manifest v2",
  "type": "object",
  "required": ["schema", "status", "attachments", "errors", "chat_policy", "dashboard_required", "dashboard_bound_to_current_state", "documents_format", "materialization_verified"],
  "properties": {
    "schema": {"const": "juriscribe-final-delivery/v2"},
    "status": {"enum": ["PASS", "FAIL"]},
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "format", "media_type", "readback", "size_bytes", "sha256"],
        "properties": {
          "id": {},
          "role": {"type": "string"},
          "path": {"type": "string"},
          "format": {"enum": ["DOCX", "HTML"]},
          "media_type": {"type": "string"},
          "readback": {"const": "PASS"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "internal_records_excluded": {"type": "integer", "minimum": 0},
    "chat_policy": {"const": "BRIEF_ARTIFACT_FIRST_ALL_POST_BOOTSTRAP"},
    "dashboard_required": {"const": true},
    "dashboard_bound_to_current_state": {"type": "boolean"},
    "documents_format": {"const": "DOCX"},
    "materialization_verified": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "dashboard_bound_to_current_state": {"const": true},
          "materialization_verified": {"const": true}
        }
      }
    }
  ]
}
