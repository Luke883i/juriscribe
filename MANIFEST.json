  "runtime": {"language": "python>=3.10", "dependencies": "stdlib-only", "workspace_root": ".juriscribe", "dashboard_name": "session-dashboard.html", "session_integrity_manifest": "session.integrity.json", "legacy_node_h": "migration-input-only", "user_setup_options": ["ACCETTA CONSIGLIATI", "MODIFICA", "ALTRO"], "bootstrap_order": ["TERMS_PRESENTED", "TERMS_ACCEPTED", "PROBE_REQUIRED", "PROBED", "INITIALIZE_REQUIRED", "INITIALIZING", "MODE_SELECTION_REQUIRED", "ACTIVE_WORK"], "admission_gate": "juriscribe.admission.require_receipt", "probe_gate": "juriscribe.bootstrap.require_probe_receipt", "reticulum_gate": "juriscribe.reticulum.validate_reticulum", "bibliography_gate": "juriscribe.bibliography.bibliography_gate", "review_standard_compatibility": "JURISCRIBE_LEGAL_MONOGRAPH_V1", "quality_gate": "juriscribe.multimode.audit_legal_text", "provenance_gate": "juriscribe.provenance.provenance_gate", "final_review_gate": "juriscribe.final_review.final_review_gate", "interaction_protocol": "juriscribe.interaction.interaction_card", "delivery_gate": "juriscribe.delivery.delivery_gate", "delivery_manifest": "juriscribe.delivery.build_delivery_manifest", "semantic_delivery_gate": "juriscribe.semantic_delivery.semantic_dossier_gate"},
  "bootstrap_hardening": {"fast_path_after_explicit_acceptance": "bootstrap-after-acceptance", "fast_path_preserves_distinct_probe_and_initialize_receipts": true, "mode_selection_stays_explicit": true, "receipt_nonces": true, "probe_receipt_single_use": true, "sealed_capabilities_immutable": true, "session_ids": "random-128-bit-derived", "workspace_overwrite": "forbidden", "session_persistence": "atomic-replace+integrity-fail-closed", "dashboard_renders_per_mutation": 1},
  "final_artifact_roles": {"common": ["evidence_dossier", "source_register", "inference_register", "transformation_ledger", "session_dashboard"], "CONTINUATION": ["final_chapter"], "GREENFIELD": ["final_legal_text"], "REVIEW": ["review_report", "review_findings_register"], "REVIEW_REPORT_AND_REVISED_TEXT": ["revised_legal_text"]},
  "delivery": {
