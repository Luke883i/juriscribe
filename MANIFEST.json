{
  "schema": "juriscribe-manifest/v9",
  "assistant": "iSeneca",
  "runtime_version": "0.9.2",
  "contract_version": "1.7.0",
  "entrypoints": {"admission_sentinel": "AGENTS.md", "admission_contract": "ISENECA_ACCESS_CONTRACT.md", "admission_manifest": "ADMISSION.json", "post_admission_agent": "docs/AGENT_RUNTIME_RULES.md", "human": "README.md", "runtime": "python -m juriscribe"},
  "modes": {"required": true, "canonical": ["CONTINUATION", "GREENFIELD", "REVIEW"], "selector": "juriscribe.multimode.select_mode", "contract": "juriscribe.modes.build_mode_contract"},
  "editorial": {"standard_id": "JURISCRIBE_LEGAL_EDITORIAL_CORE_V2", "resolver": "juriscribe.editorial.resolve_editorial_standard", "genres": ["LEGAL_CHAPTER", "LEGAL_MONOGRAPH", "LEGAL_ARTICLE", "LEGAL_ESSAY", "LEGAL_MEMORANDUM", "LEGAL_REPORT", "GENERIC_LEGAL_TEXT"]},
  "runtime": {"language": "python>=3.10", "dependencies": "stdlib-only", "workspace_root": ".juriscribe", "dashboard_name": "session-dashboard.html", "session_integrity_manifest": "session.integrity.json", "legacy_node_h": "migration-input-only", "user_setup_options": ["ACCETTA CONSIGLIATI", "MODIFICA", "ALTRO"], "bootstrap_order": ["TERMS_PRESENTED", "TERMS_ACCEPTED", "PROBE_REQUIRED", "PROBED", "INITIALIZE_REQUIRED", "INITIALIZING", "MODE_SELECTION_REQUIRED", "ACTIVE_WORK"], "admission_gate": "juriscribe.admission.require_receipt", "probe_gate": "juriscribe.bootstrap.require_probe_receipt", "reticulum_gate": "juriscribe.reticulum.validate_reticulum", "bibliography_gate": "juriscribe.bibliography.bibliography_gate", "review_standard_compatibility": "JURISCRIBE_LEGAL_MONOGRAPH_V1", "quality_gate": "juriscribe.multimode.audit_legal_text", "provenance_gate": "juriscribe.provenance.provenance_gate", "final_review_gate": "juriscribe.final_review.final_review_gate", "interaction_protocol": "juriscribe.interaction.interaction_card", "delivery_gate": "juriscribe.delivery.delivery_gate", "delivery_manifest": "juriscribe.delivery.build_delivery_manifest"},
  "final_artifact_roles": {"common": ["evidence_dossier", "source_register", "inference_register", "transformation_ledger", "session_dashboard"], "CONTINUATION": ["final_chapter"], "GREENFIELD": ["final_legal_text"], "REVIEW": ["review_report", "review_findings_register"], "REVIEW_REPORT_AND_REVISED_TEXT": ["revised_legal_text"]},
  "delivery": {
    "policy": "artifact-first",
    "surface_scope": "all-post-bootstrap",
    "chat_policy": "brief-artifact-first",
    "max_post_bootstrap_chat_lines": 3,
    "max_final_chat_lines": 3,
    "autonomous_default": true,
    "human_interruptions": "blocking-noninferable-only",
    "exception_output": "redacted-to-dashboard",
    "documents_format": "DOCX",
    "documents_media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "dashboard_format": "HTML",
    "dashboard_name": "session-dashboard.html",
    "dashboard_required": true,
    "dashboard_state_binding": true,
    "internal_records_attached": false,
    "docx_capabilities_required": ["DOCX_WRITE", "DOCX_READBACK"],
    "materialization_validation": "filesystem+OOXML+readback+sha256",
    "machine_json_opt_in_env": "JURISCRIBE_VERBOSE_JSON"
  },
  "validation": {"tests": "python -m unittest discover -s tests -v", "compile": "python -m compileall -q juriscribe scripts tests", "contract": "python scripts/check_contract.py", "simulation_v5": "python scripts/simulate_v5_ci.py --cases 400000 --seeds 11,29,47,83,131,257,509,1021,2027,4093,8191,12289,16381,24593,32771,40961,49157,57347,65537,99991 --json-out /tmp/simulation-v5.json", "reflection_v5": "python scripts/reflect_v5.py --target 1000 --json-out /tmp/reflection-v5.json", "continuation_v6": "python scripts/simulate_continuation_v6.py --json-out /tmp/continuation-v6.json", "mutation_v7": "python scripts/simulate_v7.py --cases 10000 --json-out /tmp/mutation-v7.json", "reflection_v8": "python scripts/reflect_v8.py --target 100 --json-out /tmp/reflection-v8.json", "trimode_v9": "python scripts/simulate_modes_v9.py --cases 30000 --json-out /tmp/modes-v9.json", "completion_no_novelty_target": 10000, "review_no_novelty_target": 10000, "review_no_improvement_target": 10000, "hardening_no_novelty_target": 1000},
  "schemas": ["schemas/session-state.schema.json", "schemas/mode-contract.schema.json", "schemas/editorial-standard.schema.json", "schemas/delivery-manifest.schema.json", "schemas/epistemic-unit.schema.json", "schemas/source-record.schema.json", "schemas/claim-record.schema.json", "schemas/style-profile.schema.json", "schemas/artifact-evidence.schema.json", "schemas/quality-report.schema.json", "schemas/benchmark-record.schema.json", "schemas/admission-receipt.schema.json", "schemas/bootstrap.schema.json", "schemas/probe-receipt.schema.json", "schemas/reticulum.schema.json", "schemas/generation-contract.schema.json", "schemas/continuation-plan.schema.json", "schemas/continuation-coverage.schema.json", "schemas/simulation-receipt.schema.json", "schemas/compression-record.schema.json", "schemas/review-cycle.schema.json", "schemas/review-saturation.schema.json", "schemas/regeneration-record.schema.json", "schemas/bibliography.schema.json", "schemas/interaction-card.schema.json", "schemas/provenance-bundle.schema.json", "schemas/final-review.schema.json"]
}
