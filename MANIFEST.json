  "validation": {"tests": "python -m unittest discover -s tests -v", "compile": "python -m compileall -q juriscribe scripts tests", "contract": "python scripts/check_contract.py", "simulation_v5": "python scripts/simulate_v5_ci.py --cases 400000 --seeds 11,29,47,83,131,257,509,1021,2027,4093,8191,12289,16381,24593,32771,40961,49157,57347,65537,99991 --json-out /tmp/simulation-v5.json", "reflection_v5": "python scripts/reflect_v5.py --target 1000 --json-out /tmp/reflection-v5.json", "continuation_v6": "python scripts/simulate_continuation_v6.py --json-out /tmp/continuation-v6.json", "mutation_v7": "python scripts/simulate_v7.py --cases 10000 --json-out /tmp/mutation-v7.json", "reflection_v8": "python scripts/reflect_v8.py --target 100 --json-out /tmp/reflection-v8.json", "trimode_v9": "python scripts/simulate_modes_v9.py --cases 30000 --json-out /tmp/modes-v9.json", "completion_no_novelty_target": 10000, "review_no_novelty_target": 10000, "review_no_improvement_target": 10000, "hardening_no_novelty_target": 1000},
  "schemas": ["schemas/session-state.schema.json", "schemas/mode-contract.schema.json", "schemas/editorial-standard.schema.json", "schemas/delivery-manifest.schema.json", "schemas/legal-humanistic-artifact.schema.json", "schemas/epistemic-unit.schema.json", "schemas/source-record.schema.json", "schemas/claim-record.schema.json", "schemas/style-profile.schema.json", "schemas/artifact-evidence.schema.json", "schemas/quality-report.schema.json", "schemas/benchmark-record.schema.json", "schemas/admission-receipt.schema.json", "schemas/bootstrap.schema.json", "schemas/probe-receipt.schema.json", "schemas/reticulum.schema.json", "schemas/generation-contract.schema.json", "schemas/continuation-plan.schema.json", "schemas/continuation-coverage.schema.json", "schemas/simulation-receipt.schema.json", "schemas/compression-record.schema.json", "schemas/review-cycle.schema.json", "schemas/review-saturation.schema.json", "schemas/regeneration-record.schema.json", "schemas/bibliography.schema.json", "schemas/interaction-card.schema.json", "schemas/provenance-bundle.schema.json", "schemas/final-review.schema.json"]
